# Caddy — reverse proxy + auto HTTPS
# Локально: DOMAIN=localhost → http. В проде: DOMAIN=ritual.kg → auto TLS + http→https.

{$DOMAIN:ritual.kg} {
	# www → apex redirect (раскомментировать если нужен www)
	# @www host www.{$DOMAIN:ritual.kg}
	# redir @www https://{$DOMAIN:ritual.kg}{uri} permanent

	reverse_proxy app:3000

	header {
		# базовая гигиена
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# HSTS только для https (Caddy добавит сам при TLS)
	}

	encode gzip
	log {
		output stdout
		format console
	}
}
